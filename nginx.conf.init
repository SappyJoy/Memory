# nginx.conf.init - For initial Let's Encrypt challenge

server {
    listen 80 default_server;
    listen [::]:80 default_server; # Also listen on IPv6 if enabled

    server_name styopa.xyz www.styopa.xyz;

    # This is where Certbot will place challenge files.
    # Nginx needs to serve from the same volume Certbot writes to.
    # The volume is certbot_webroot, mounted at /var/www/certbot in both containers.
    root /var/www/certbot; 

    location /.well-known/acme-challenge/ {
        # try_files $uri =404; # Let Nginx serve files directly from root
        # No special handling needed here if root is set correctly.
    }

    # Optional: For any other requests, you can return a temporary page or a 404.
    location / {
        return 404; 
        # Or:
        # add_header Content-Type text/plain;
        # return 200 'HTTPS certificate setup in progress. Please try again shortly.';
    }

    # Optional: Specific logging for challenge attempts can be useful for debugging
    access_log /var/log/nginx/challenge.access.log;
    error_log /var/log/nginx/challenge.error.log;
}
